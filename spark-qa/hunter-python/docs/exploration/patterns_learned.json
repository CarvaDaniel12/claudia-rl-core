  "advice_from_real_runs": {
    "critical_learnings": [
      {
        "lesson": "URL navigation > Menu clicks",
        "evidence": "Menu clicks failed 100% after agency selection. URL navigation worked 100%.",
        "application": "ALWAYS use page.goto(base_url + '#/section') instead of clicking menu",
        "confidence": 1.0,
        "runs_validated": 10
      },
      {
        "lesson": "Lead delete button unreliable",
        "evidence": "lead-action-button-CLOSE_LEAD timeout 10/10 times",
        "application": "Use ESC key to close lead modal. Skip button entirely.",
        "confidence": 1.0,
        "runs_validated": 10
      },
      {
        "lesson": "Property search by UUID is 100% reliable",
        "evidence": "Search by UUID found property 10/10 times. Search by name had issues.",
        "application": "Always extract property UUID from URL and search by UUID for delete.",
        "confidence": 1.0,
        "runs_validated": 10
      },
      {
        "lesson": "Nested selectors more specific",
        "evidence": "form-footer > save-button worked better than just save-button",
        "application": "When multiple elements possible, use nested parent > child selector",
        "confidence": 0.9,
        "runs_validated": 8
      },
      {
        "lesson": "State field is INPUT not SELECT",
        "evidence": "propertyAddress.state changed from <select> to <input> in staging",
        "application": "Use .fill() not .select_option() for state field",
        "confidence": 1.0,
        "runs_validated": 10
      }
    ],

    "exploration_tips": [
      {
        "tip": "Start with URL navigation for all sections",
        "sections": ["properties", "leads", "calendar", "inbox", "pipeline"],
        "reason": "Bypasses menu visibility issues completely"
      },
      {
        "tip": "Use autocomplete search when available",
        "elements": ["propertySearch", "leadSearch"],
        "reason": "More reliable than clicking from list"
      },
      {
        "tip": "Prefer test-id selectors over role/text",
        "reason": "Test-IDs are stable, text/roles can change with translations"
      },
      {
        "tip": "ESC key is universal modal closer",
        "reason": "When close button doesn't appear, ESC always works"
      },
      {
        "tip": "Extract UUIDs from URLs for cleanup",
        "reason": "UUID search is 100% unique, name search can have duplicates"
      }
    ],


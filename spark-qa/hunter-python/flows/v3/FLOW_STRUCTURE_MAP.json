  "cleanup_requirements": {
    "current": [
      "Delete 1 regular property created in step 2"
    ],
    "needed_for_expansion": [
      "Delete multi-unit property if created (track multi_unit_property_name)"
    ],
    "NOT_needed_separate_deletion": [
      "Leads created from calendar (auto-deleted with property)",
      "Blocks created from calendar (auto-deleted with property)",
      "Any entities tied to property being deleted"
    ],
    "critical": "MUST delete all PROPERTIES created. Related entities (leads, blocks) auto-delete with property."
  },
  
  "expansion_strategy": {
    "safe_additions": {
      "property_pricing_tab": {
        "insert_after": "AMENITIES_TAB (step 4)",
        "new_step": "4C_PRICING_TAB",
        "actions": [
          "Navigate to Pricing tab (property-settings-tab-pricing)",
          "Click add price rule (price-rules-header-button)",
          "Fill rule name, type, modifier",
          "Save rule"
        ],
        "risk": "low - separate tab, won't break existing"
      },
      "property_fees_taxes_tab": {
        "insert_after": "4C_PRICING_TAB",
        "new_step": "4D_FEES_TAXES_TAB",
        "actions": [
          "Navigate to Fees tab (property-settings-tab-fees-and-policies)",
          "Click add fee (property-fees-taxes-button)",
          "Fill fee name, type, amount",
          "Save fee"
        ],
        "risk": "low - separate tab, won't break existing"
      },
      "calendar_interactions": {
        "insert_after": "CALENDAR_PAGE (step 9)",
        "new_step": "9B_CALENDAR_INTERACTIONS",
        "actions": [
          "Switch to pricing mode",
          "Apply filters",
          "Create block from calendar (for property that will be deleted)"
        ],
        "DO_NOT": "Create leads - can block property deletion",
        "risk": "low - blocks auto-delete when property deleted"
      },
      "analytics_validation": {
        "insert_after": "ANALYTICS_PAGE (step 8)",
        "new_step": "8B_ANALYTICS_VALIDATION",
        "actions": [
          "Change date ranges (TODAY, LAST_WEEK, THIS_WEEK, etc)",
          "View metrics panels",
          "VALIDATE calculated values (RevPar, ADR, occupancy, revenue)",
          "Check if pricing/fees/taxes are correctly summed/multiplied/divided",
          "Compare expected vs actual values in graphs/panels"
        ],
        "risk": "low - read-only, but HIGH VALUE for validation",
        "validation_opportunity": "CRITICAL - Analytics shows if prices, fees, taxes are calculated correctly in platform"
      }
    },
    "high_risk_additions": {
      "multi_unit_property": {
        "reason": "Creates second property that MUST be tracked and deleted",
        "required_changes": [
          "Track multi_unit_property_name variable",
          "Add deletion logic in cleanup for multi-unit properties"
        ]
      }
    }
  },
  
  "notes_for_implementation": [
    "Pricing tab has BOTH basic pricing fields AND price rules sections",
    "Fees & Taxes tab (separate) has custom fees, house rules, policies",
    "Main Settings may or may not have pricing fields (backend uncertain)",
    "Always save after filling tab before moving to next",
    "Track ALL created PROPERTIES for cleanup",
    "Leads/blocks tied to property auto-delete when property deleted - no separate cleanup needed",
    "Use try-except for each expansion so failure doesn't break core flow",
    "Test each addition incrementally before adding next"
  ]
}

